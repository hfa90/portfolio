{
  "manifest_version": 3,
  "name": "Prospecta · Captura no Google Maps",
  "short_name": "Prospecta",
  "version": "2.0.0",
  "description": "Captura empresas do Google Maps (nome, telefone, endereço, bairro, avaliação, site) direto para sua lista de leads no Prospecta.",
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": { "default_popup": "popup.html", "default_title": "Prospecta", "default_icon": { "16": "icons/16.png", "48": "icons/48.png" } },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.google.com/maps/*",
    "https://www.google.com.br/maps/*",
    "https://uvculminojmtltdulpsa.supabase.co/*"
  ],
  "content_scripts": [{
    "matches": ["https://www.google.com/maps/*", "https://www.google.com.br/maps/*"],
    "js": ["parser.js", "content.js"],
    "run_at": "document_idle"
  }]
}
